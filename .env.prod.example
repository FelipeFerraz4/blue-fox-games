###############################################################################
# Blue Fox Games - Configurações de Produção
###############################################################################

# Subir com docker-compose:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Baixar os containers:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod down
#
# O reverse proxy precisa repassar WebSocket (headers Upgrade/Connection) para o container.

NODE_ENV=production
PORT=3001
DOCKER_NETWORK=infra-net

# Atrás do reverse proxy: usa o último IP do X-Forwarded-For para os limites por IP.
# Só use true se o container NÃO tiver porta publicada (acesso só via proxy na infra-net).
TRUST_PROXY=true

# Proteção contra abuso (salas ficam em memória)
MAX_ROOMS=500
MAX_CONNECTIONS_PER_IP=20
ROOM_CREATE_LIMIT_PER_MIN=10
