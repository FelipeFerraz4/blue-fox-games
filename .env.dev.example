###############################################################################
# Blue Fox Games - Configurações de Desenvolvimento
###############################################################################

# Subir com docker-compose:
# docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d --build
# Baixar os containers:
# docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev down

NODE_ENV=development
PORT=3001
DOCKER_NETWORK=infra-net

# Em dev a porta é publicada direto, então não confie no X-Forwarded-For.
TRUST_PROXY=false

# Proteção contra abuso (salas ficam em memória)
MAX_ROOMS=500
MAX_CONNECTIONS_PER_IP=20
ROOM_CREATE_LIMIT_PER_MIN=10
